{
  "expo": {
    "name": "LearnStreak",
    "slug": "learnstreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "learnstreak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.learnstreak",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow LearnStreak to recognise your speech for voice input.",
        "NSMicrophoneUsageDescription": "Allow LearnStreak to use the microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yourname.learnstreak",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "organization": "YOUR_SENTRY_ORG",
          "project": "YOUR_SENTRY_PROJECT"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A0A0A",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "LearnStreak"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LearnStreak to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow LearnStreak to recognise your speech for voice input."
        }
      ],
      "@sentry/react-native",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "242e27dd-64ed-4865-b556-a61f2c29e720"
      }
    }
  }
}
