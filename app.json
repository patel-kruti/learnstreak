{
  "expo": {
    "name": "LearnStreak",
    "slug": "learnstreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "learnstreak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.learnstreak"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yourname.learnstreak",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A0A0A",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "LearnStreak"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LearnStreak to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow LearnStreak to recognise your speech for voice input."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}